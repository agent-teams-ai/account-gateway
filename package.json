{
  "name": "account-gateway-workspace",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node scripts/build.mjs",
    "test": "node --run check:toolchain-config && node --run test:consumer-pin && node --test tests/*.test.mjs tests/*.test.mts tests/whole-consumer.test.ts",
    "typecheck:tests": "tsc --project tsconfig.tests.json",
    "test:static": "node --run check:toolchain-config && node --run test:consumer-pin && node --test --test-name-pattern=\"public Core/Assembly\" tests/client.test.mjs && node --test tests/source-policy.test.mjs",
    "test:consumer-pin": "tsc --project tsconfig.consumer-pin.json && node --test tests/consumer-module-pin.test.ts",
    "foundation": "agent-teams-foundation check architecture.source-dependencies --consumer .",
    "docs:check": "agent-teams-docs check --consumer . --profile docs.config.yaml",
    "check:topology": "node scripts/check-topology.mjs",
    "qualify:consumers": "bash scripts/qualify-consumers.sh",
    "toolchain:doctor": "stack-toolchain doctor --json",
    "typecheck": "stack-toolchain typecheck",
    "lint": "stack-toolchain lint",
    "format:check": "stack-toolchain format:check",
    "foundation:dev-only": "agent-teams-foundation assert-dev-only --consumer . --json",
    "check:toolchain-config": "node scripts/check-toolchain-config.ts"
  },
  "devDependencies": {
    "@agent-teams/account-gateway": "workspace:*",
    "@agent-teams/docs-protocol": "0.6.2",
    "@agent-teams/engineering-foundation": "3.0.0",
    "@get-modular/assembly": "0.2.0",
    "@get-modular/core": "0.2.0",
    "@types/node": "24.19.1",
    "stack-toolchain": "0.1.1",
    "typescript": "7.0.2"
  },
  "engines": {
    "node": ">=24.21.0 <25 || >=26.10.0 <27"
  },
  "packageManager": "pnpm@11.28.2"
}
