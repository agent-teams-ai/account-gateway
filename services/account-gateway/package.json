{
  "name": "@agent-teams/account-gateway-kernel",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": { "node": "24.21.x" },
  "scripts": {
    "typecheck": "tsc --project tsconfig.json",
