      "composition": "get-modular",
      "publicIndexes": [
        "contracts/index.ts",
        "http/index.ts",
        "llm/index.ts",
        "index.ts"
      ],
      "tests": [
        "tests/client.test.mjs",
        "tests/source-policy.test.mjs",
        "tests/llm.test.mts",
        "tests/llm-strict-schema.test.mts"
      ]
    }
  ],
  "excluded": [
    "engine",
    "apps/gateway",
    ".spike-inputs",
    "node_modules",
    "docs/corpus"
  ],
  "deviations": [
    {
      "scope": "tests",
      "reason": "Root black-box tests exercise packaged facade clients, the llm entry and module composition through built public entries; no detached white-box unit tree.",
      "owner": "gateway-maintainers",
      "reviewTrigger": "Add a third feature or a service."
    }
  ],
  "enforcement": [
    "node scripts/check-topology.mjs",
    "pnpm foundation",
    "pnpm test",
    "pnpm docs:check"
  ],
  "decision": "docs/COMPOSITION.md"
